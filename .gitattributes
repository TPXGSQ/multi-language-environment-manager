# 统一换行符策略
# Windows 批处理必须是 CRLF，否则 cmd 解析会出错
*.bat           text eol=crlf
*.cmd           text eol=crlf

# 其余文本文件统一 LF（GitHub 渲染、YAML 解析都更稳）
*.java          text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.xml           text eol=lf
*.cfg           text eol=lf
LICENSE         text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# 二进制文件：禁止任何换行/编码转换
*.jar           binary
*.ico           binary
*.png           binary
*.jpg           binary
*.exe           binary
*.dll           binary
*.class         binary

# 打包产物与运行时数据：不参与 diff 统计
dist/**         linguist-vendored
